# Copy to .env and fill in — .env is gitignored, never commit real keys.

# --- SMS (OTP delivery) ---
# Leave unset to keep the current behavior: the OTP is returned directly in
# the POST /api/orders response instead of being texted (see server/sms.js).
# Sign up with an Ethiopian bulk-SMS gateway (AfroMessage, Geez SMS, etc.),
# then set these from THEIR docs — sms.js's request body is a generic guess
# and will likely need adjusting to match your provider's actual API.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=AderaDelivery

# --- Server ---
# PORT=3000
# DATABASE_PATH=./data/adera-delivery.db
