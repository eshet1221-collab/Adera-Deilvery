# Copy to .env and fill in — .env is gitignored, never commit real keys.

# --- SMS (OTP delivery) ---
# Leave unset to keep the current behavior: the OTP is returned directly in
# the POST /api/orders response instead of being texted (see server/sms.js).
# Sign up with an Ethiopian bulk-SMS gateway (AfroMessage, Geez SMS, etc.),
# then set these from THEIR docs — sms.js's request body is a generic guess
# and will likely need adjusting to match your provider's actual API.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=LoyalDeliveryMovers

# --- Server ---
# PORT=3000
# DATABASE_PATH=./data/loyal-delivery-movers.db

# --- Admin account ---
# The one shared admin login for admin.html/couriers.html/call-center.html/
# earnings.html. Set both and restart the server to create (or reset the
# password of) that account — there's no signup form for this, unlike
# couriers. Leaving these unset means no admin account exists at all.
ADMIN_USERNAME=
ADMIN_PASSWORD=
